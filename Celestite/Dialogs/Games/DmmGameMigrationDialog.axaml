<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/winfx/2008/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             xmlns:vm="using:Celestite.ViewModels.Dialogs"
             xmlns:fluent="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:locale="using:Celestite.I18N"
             x:DataType="vm:DmmGameMigrationDialogViewModel"
             x:Class="Celestite.Dialogs.Games.DmmGameMigrationDialog">
	<StackPanel Spacing="12" Margin="20">
		<TextBlock Text="{Binding GameData.Title}" Theme="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"></TextBlock>
		
		<fluent:SettingsExpander
			IconSource="Folder"
			Header="{x:Static locale:Localization.MigrateCurrentPath}"
			Description="{Binding CurrentGamePath}"
			IsClickEnabled="False">
		</fluent:SettingsExpander>

		<fluent:SettingsExpander
			IconSource="Edit"
			Header="{x:Static locale:Localization.MigrateTargetPath}"
			Description="{Binding TargetGamePath}"
			IsClickEnabled="True"
			ActionIconSource="ChevronRight"
			Command="{Binding PickTargetFolderCommand}">
		</fluent:SettingsExpander>

		<CheckBox Content="{x:Static locale:Localization.MigrateDeleteSource}" IsChecked="{Binding DeleteSourceAfterMigration}"></CheckBox>

		<ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsBusy}"></ProgressBar>
		<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"></TextBlock>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 12 0 0">
			<Button Content="{x:Static locale:Localization.ButtonCancel}" Command="{Binding CloseCommand}" Theme="{StaticResource TransparentButton}"></Button>
			<Button Content="{x:Static locale:Localization.MigrateStartButton}" Command="{Binding MigrateCommand}" IsEnabled="{Binding !IsBusy}"></Button>
			<Button Content="{x:Static locale:Localization.MigrateCancelButton}" Command="{Binding CancelMigrationCommand}" IsEnabled="{Binding IsBusy}" Theme="{StaticResource TransparentButton}"></Button>
		</StackPanel>
	</StackPanel>
</UserControl>
