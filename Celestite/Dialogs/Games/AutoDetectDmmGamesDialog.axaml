<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/winfx/2008/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             xmlns:vm="using:Celestite.ViewModels.Dialogs"
             xmlns:fluent="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:locale="using:Celestite.I18N"
             x:DataType="vm:AutoDetectDmmGamesDialogViewModel"
             x:Class="Celestite.Dialogs.Games.AutoDetectDmmGamesDialog">
	<StackPanel Spacing="12" Margin="20">
		<TextBlock Text="{x:Static locale:Localization.AutoDetectTitle}" Theme="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"></TextBlock>
		<TextBlock Text="{x:Static locale:Localization.AutoDetectDescription}" TextWrapping="Wrap" Opacity="0.8"></TextBlock>

		<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0 0 0 8"></TextBlock>

		<ScrollViewer MaxHeight="300">
			<ItemsControl ItemsSource="{Binding DetectedGames}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:DetectedGameItem">
						<StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4">
							<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"></CheckBox>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="{Binding Title}" FontWeight="Bold"></TextBlock>
								<TextBlock Text="{Binding ProductId}" FontSize="9" Opacity="0.7"></TextBlock>
								<TextBlock Text="{Binding InstallPath}" FontSize="9" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="400"></TextBlock>
							</StackPanel>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 12 0 0">
			<Button Content="{x:Static locale:Localization.ButtonCancel}" Command="{Binding CloseCommand}" Theme="{StaticResource TransparentButton}"></Button>
			<Button Content="{x:Static locale:Localization.AutoDetectAddButton}" Command="{Binding AddSelectedGamesCommand}" IsEnabled="{Binding !IsBusy}"></Button>
		</StackPanel>
	</StackPanel>
</UserControl>
